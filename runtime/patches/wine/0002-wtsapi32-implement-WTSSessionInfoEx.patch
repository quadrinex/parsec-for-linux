--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -632,6 +632,45 @@
         return TRUE;
     }
 
+    if (class == WTSSessionInfoEx)
+    {
+        /* plh: single local console session, always active and unlocked
+         * (the Linux session lock state is not visible from Wine). */
+        WTSINFOEXW *info;
+        WTSINFOEX_LEVEL1_W *l1;
+        FILETIME ft;
+        DWORD size;
+
+        if (!(info = calloc(1, sizeof(*info)))) return FALSE;
+        info->Level = 1;
+        l1 = &info->Data.WTSInfoExLevel1;
+        if (!ProcessIdToSessionId(GetCurrentProcessId(), &l1->SessionId))
+        {
+            free(info);
+            return FALSE;
+        }
+        if (session_id != WTS_CURRENT_SESSION && session_id != l1->SessionId)
+        {
+            free(info);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        l1->SessionState = WTSActive;
+        l1->SessionFlags = WTS_SESSIONSTATE_UNLOCK;
+        wcscpy(l1->WinStationName, L"Console");
+        size = ARRAY_SIZE(l1->UserName);
+        GetUserNameW(l1->UserName, &size);
+        size = ARRAY_SIZE(l1->DomainName);
+        GetComputerNameW(l1->DomainName, &size);
+        GetSystemTimeAsFileTime(&ft);
+        l1->CurrentTime.LowPart = ft.dwLowDateTime;
+        l1->CurrentTime.HighPart = ft.dwHighDateTime;
+        l1->LogonTime = l1->ConnectTime = l1->LastInputTime = l1->CurrentTime;
+        *buffer = (WCHAR *)info;
+        *count = sizeof(*info);
+        return TRUE;
+    }
+
     FIXME("Unimplemented class %d\n", class);
 
     *buffer = NULL;
