+     * flag values there without the LDR_PATH_IS_FLAGS (1) bit. Treat them as flags instead of
+     * dereferencing them. */
+    if (!search_path || ((ULONG_PTR)search_path & 1) || !((ULONG_PTR)search_path >> 16))
     {
         if ((nts = LdrGetDllPath( libname->Buffer, (ULONG_PTR)search_path & load_library_search_flags, &path_name, &dummy )))
             return nts;
