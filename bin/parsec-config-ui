        self._build_tab_bridge()
        self._build_tab_hotkeys()
        self._build_tab_logs()

        self.load_all_configs()
        self.refresh_status()

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_status)
        self.timer.start(2000)

