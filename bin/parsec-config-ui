    "PLH_D3D_TRACE": "0",
    "PLH_BRIDGE_VERBOSE": "0",
    "PLH_BRIDGE_PORT": "0",
}


class CommandRunner(QThread):
    finished_cmd = Signal(int, str)

    def __init__(self, cmd: list[str], parent=None):
        super().__init__(parent)
        self.cmd = cmd

    def run(self):
        try:
            proc = subprocess.run(
                self.cmd,
                cwd=str(ROOT),
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                timeout=30,
                 close_fds=True,
            )
            self.finished_cmd.emit(proc.returncode, proc.stdout.strip())
        except Exception as exc:
            self.finished_cmd.emit(1, str(exc))


def read_config_env() -> dict[str, str]:
    cfg = dict(DEFAULT_ENV)
    if not CONFIG_ENV.exists():
        return cfg
    for raw in CONFIG_ENV.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        # Supports: export KEY="val", : "${KEY:=val}", or KEY=val
        m = re.match(r'^:\s*"\$\{([A-Za-z0-9_]+):=(.*)\}"$', line)
        if m:
            k, v = m.group(1), m.group(2)
            cfg[k] = v.strip("\"'")
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            cfg[k.strip()] = v.strip().strip("\"'")
    return cfg


def write_config_env(cfg: dict[str, str]) -> None:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    lines = [
        "# shellcheck shell=bash",
        "# File generated by bin/parsec-config-ui — Linux bridge configuration.",
        "# Uses: \"${VAR:=val}\" so that tests can override a variable.",
        "",
    ]
    for k, default_v in DEFAULT_ENV.items():
        val = cfg.get(k, default_v)
        safe = str(val).replace('"', '\\"')
        lines.append(f': "${{{k}:={safe}}}"')
        lines.append(f"export {k}")
    lines.append("")
    CONFIG_ENV.write_text("\n".join(lines), encoding="utf-8")


def read_parsec_config() -> dict:
    if not PARSEC_CONFIG_JSON.exists():
        return {}
    try:
        raw = json.loads(PARSEC_CONFIG_JSON.read_text(encoding="utf-8", errors="replace"))
        if isinstance(raw, list) and len(raw) >= 2 and isinstance(raw[1], dict):
            out = {}
            for k, v in raw[1].items():
                if isinstance(v, dict) and "value" in v:
                    out[k] = v["value"]
                else:
                    out[k] = v
            return out
        if isinstance(raw, dict):
            return raw
    except Exception:
        pass
    return {}


def write_parsec_config(values: dict) -> None:
    PARSEC_APPDATA.mkdir(parents=True, exist_ok=True)
    formatted = {}
    for k in sorted(values.keys()):
        v = values[k]
        if v is None or v == "":
            continue
        formatted[k] = {"value": v}
    payload = [PARSEC_DOC_HEADER, formatted]
    text = json.dumps(payload, indent="\t", ensure_ascii=False)
    PARSEC_CONFIG_JSON.write_text(text + "\n", encoding="utf-8")


def detect_kwin_outputs() -> list[dict]:
    outputs = []
    try:
        res = subprocess.run(
            ["kscreen-doctor", "-o"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        )
        clean = re.sub(r"\x1b\[[0-9;]*m", "", res.stdout)
        cur = None
        for line in clean.splitlines():
            m = re.match(r"^Output:\s+(\d+)\s+(\S+)\s*(\S*)", line)
            if m:
                if cur:
                    outputs.append(cur)
                cur = {
                    "id": int(m.group(1)),
                    "name": m.group(2),
                    "uuid": m.group(3),
                    "enabled": False,
                    "priority": 99,
                    "geometry": "",
                    "mode": "",
                }
            elif cur:
                s = line.strip()
                if s == "enabled":
                    cur["enabled"] = True
                elif s.startswith("priority "):
                    try:
                        cur["priority"] = int(s.split()[1])
                    except ValueError:
                        pass
                elif s.startswith("Geometry:"):
                    cur["geometry"] = s.split("Geometry:", 1)[1].strip()
                elif s.startswith("Modes:"):
                    m_mode = re.search(r"(\d+x\d+@\d+(?:\.\d+)?)\*", s)
                    if m_mode:
                        cur["mode"] = m_mode.group(1)
        if cur:
            outputs.append(cur)
    except Exception:
        pass
    return outputs


def detect_dri_devices() -> list[str]:
    devs = sorted(str(p) for p in Path("/dev/dri").glob("renderD*"))
    return devs if devs else ["/dev/dri/renderD128"]


def detect_pipewire_sinks() -> list[tuple[str, str, bool]]:
    """Returns [(id, label, is_default), ...] from wpctl status."""
    sinks = []
    try:
        res = subprocess.run(
            ["wpctl", "status"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
        )
        in_sinks = False
        for line in res.stdout.splitlines():
            if "Sinks:" in line:
                in_sinks = True
                continue
            if in_sinks:
                if any(h in line for h in ("Sources:", "Filters:", "Streams:", "Video", "Settings")):
                    break
                m = re.search(r"(\*?)\s*(\d+)\.\s+(.+?)(?:\s+\[vol:.*)?$", line)
                if m:
                    is_def = m.group(1) == "*"
                    sid = m.group(2)
                    name = m.group(3).strip()
                    sinks.append((sid, name, is_def))
    except Exception:
        pass
    return sinks


class StatusBadge(QLabel):
    def __init__(self, text="Unknown", parent=None):
        super().__init__(text, parent)
        self.setAlignment(Qt.AlignCenter)
        self.setMinimumWidth(95)
        self.set_state(False, text)

    def set_state(self, ok: bool, text: str, warn: bool = False):
        self.setText(text)
        if warn:
            bg, fg, border = "#3d3117", "#f5b041", "#9a7d0a"
        elif ok:
            bg, fg, border = "#153827", "#48c78e", "#257953"
        else:
            bg, fg, border = "#3b181c", "#f14668", "#8a2538"
        self.setStyleSheet(
            f"QLabel {{ background-color: {bg}; color: {fg}; border: 1px solid {border}; "
            f"border-radius: 5px; padding: 3px 8px; font-weight: bold; font-size: 12px; }}"
        )


