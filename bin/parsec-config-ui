ROOT = Path(__file__).resolve().parent.parent
RUNTIME = ROOT / "runtime"
CONFIG_ENV = RUNTIME / "config.env"
# Same data location as runtime/env.sh.
if os.environ.get("PLH_DATA_DIR"):
    DATA_DIR = Path(os.environ["PLH_DATA_DIR"])
elif os.access(RUNTIME, os.W_OK):
    DATA_DIR = RUNTIME
else:
    DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "parsec-for-linux"
TRACES_DIR = DATA_DIR / "traces"
USER = getpass.getuser()
PARSEC_APPDATA = DATA_DIR / "prefix" / "drive_c" / "users" / USER / "AppData" / "Roaming" / "Parsec"
PARSEC_CONFIG_JSON = PARSEC_APPDATA / "config.json"
PARSEC_HOTKEY_JSON = PARSEC_APPDATA / "hotkey.json"
PARSEC_LOG = PARSEC_APPDATA / "log.txt"
HOST_CTL = ROOT / "bin" / "parsec-linux-host"

PARSEC_DOC_HEADER = (
    "See https://parsec.app/config for documentation and example. "
    "JSON must be valid before saving or file be will be erased."
)

# Defaults of runtime/config.env
DEFAULT_ENV = {
    "PLH_CAPTURE_BACKEND": "kwin",
    "PLH_ENABLE_AMF": "1",
    "PLH_ENC_DEVICE": "/dev/dri/renderD128",
    "PLH_AMF_LOG": "",
    "PLH_ENABLE_INPUT": "1",
    "PLH_ENABLE_GAMEPAD": "1",
    "PLH_INPUT_BACKEND": "uinput",
    "PLH_INPUT_MOUSE_MODE": "abs",
