    # =========================================================================
    # LOGIC: READING / WRITING CONFIGURATIONS
    # =========================================================================
    def load_all_configs(self):
        self.load_parsec_tab()
        self.load_bridge_tab()
        self.load_hotkeys_tab()
        self.refresh_displays_table()
        self.refresh_log_view()

    def _on_res_preset_changed(self, idx: int):
        data = self.combo_res_preset.itemData(idx)
        if not data:
            return
        rx, ry = data
        if rx >= 0 and ry >= 0:
            self.spin_res_x.setValue(rx)
            self.spin_res_y.setValue(ry)

    def load_parsec_tab(self):
        cfg = read_parsec_config()
        bitrate = int(cfg.get("encoder_bitrate", 25))
        self.spin_bitrate.setValue(bitrate)
        self.slider_bitrate.setValue(min(150, bitrate))

        fps = int(cfg.get("encoder_fps", 60))
        idx_fps = self.combo_fps.findData(fps)
        self.combo_fps.setCurrentIndex(idx_fps if idx_fps >= 0 else 0)

        h265 = int(cfg.get("encoder_h265", 0))
        idx_codec = self.combo_codec.findData(h265)
        self.combo_codec.setCurrentIndex(idx_codec if idx_codec >= 0 else 0)

        self.spin_min_qp.setValue(int(cfg.get("encoder_min_qp", 0)))
        self.spin_max_qp.setValue(int(cfg.get("encoder_max_qp", 0)))

        rx = int(cfg.get("server_resolution_x", 65535))
        ry = int(cfg.get("server_resolution_y", 65535))
        self.spin_res_x.setValue(rx)
        self.spin_res_y.setValue(ry)
        matched_preset = len(self.res_presets) - 1
        for i, (_, coords) in enumerate(self.res_presets):
            if coords == (rx, ry):
                matched_preset = i
                break
        self.combo_res_preset.blockSignals(True)
        self.combo_res_preset.setCurrentIndex(matched_preset)
        self.combo_res_preset.blockSignals(False)

        self.edit_host_output.setText(str(cfg.get("host_output", "")))
        self.spin_host_port.setValue(int(cfg.get("network_server_start_port", 0)))
        self.chk_upnp.setChecked(int(cfg.get("network_upnp", 1)) == 1)
        self.spin_max_guests.setValue(int(cfg.get("host_max_guests", 1)))
        self.chk_exclusive_input.setChecked(int(cfg.get("host_exclusive_input", 0)) == 1)
        self.chk_gamepad.setChecked(int(cfg.get("host_gamepad_type", 1)) != 0)

        self.txt_parsec_json.setPlainText(json.dumps(cfg, indent=2, ensure_ascii=False))

    def _collect_parsec_dict_from_ui(self) -> dict:
        # Starts from the JSON in the advanced editor to preserve app_block_hash, app_channel, etc.
        base = read_parsec_config()
        try:
            edited = json.loads(self.txt_parsec_json.toPlainText())
            if isinstance(edited, dict):
                base.update(edited)
        except Exception:
            pass

        base["encoder_bitrate"] = self.spin_bitrate.value()
        base["encoder_fps"] = self.combo_fps.currentData()
        base["encoder_h265"] = self.combo_codec.currentData()

        if self.spin_min_qp.value() > 0:
            base["encoder_min_qp"] = self.spin_min_qp.value()
        else:
            base.pop("encoder_min_qp", None)

        if self.spin_max_qp.value() > 0:
            base["encoder_max_qp"] = self.spin_max_qp.value()
        else:
            base.pop("encoder_max_qp", None)

        base["server_resolution_x"] = self.spin_res_x.value()
        base["server_resolution_y"] = self.spin_res_y.value()

        ho = self.edit_host_output.text().strip()
        if ho:
            base["host_output"] = ho
        else:
            base.pop("host_output", None)

        if self.spin_host_port.value() > 0:
            base["network_server_start_port"] = self.spin_host_port.value()
        else:
            base.pop("network_server_start_port", None)

        base["network_upnp"] = 1 if self.chk_upnp.isChecked() else 0
        base["host_max_guests"] = self.spin_max_guests.value()
        base["host_exclusive_input"] = 1 if self.chk_exclusive_input.isChecked() else 0
        base["host_gamepad_type"] = 1 if self.chk_gamepad.isChecked() else 0
        return base

    def sync_form_to_parsec_json_preview(self):
        merged = self._collect_parsec_dict_from_ui()
        self.txt_parsec_json.setPlainText(json.dumps(merged, indent=2, ensure_ascii=False))

    def save_parsec_tab(self, restart: bool = False):
        merged = self._collect_parsec_dict_from_ui()
        write_parsec_config(merged)
        self.txt_parsec_json.setPlainText(json.dumps(merged, indent=2, ensure_ascii=False))
        self.status_bar.showMessage(f"Parsec configuration saved to {PARSEC_CONFIG_JSON}", 5000)
        if restart:
            self.run_host_action("restart")

    def load_bridge_tab(self):
        cfg = read_config_env()
        idx_cap = self.combo_cap_backend.findData(cfg.get("PLH_CAPTURE_BACKEND", "kwin"))
        self.combo_cap_backend.setCurrentIndex(idx_cap if idx_cap >= 0 else 0)

        self.chk_d3d_trace.setChecked(cfg.get("PLH_D3D_TRACE", "0") == "1")
        self.chk_enable_amf.setChecked(cfg.get("PLH_ENABLE_AMF", "1") == "1")
        self.combo_dri_dev.setCurrentText(cfg.get("PLH_ENC_DEVICE", "/dev/dri/renderD128"))
        self.edit_amf_log.setText(cfg.get("PLH_AMF_LOG", ""))

        self.chk_enable_input.setChecked(cfg.get("PLH_ENABLE_INPUT", "1") == "1")
        self.chk_enable_gamepad.setChecked(cfg.get("PLH_ENABLE_GAMEPAD", "1") == "1")
        idx_mm = self.combo_mouse_mode.findData(cfg.get("PLH_INPUT_MOUSE_MODE", "abs"))
        self.combo_mouse_mode.setCurrentIndex(idx_mm if idx_mm >= 0 else 0)

        self.chk_enable_clipboard.setChecked(cfg.get("PLH_ENABLE_CLIPBOARD", "1") == "1")

        idx_wf = self.combo_wine_flavor.findData(cfg.get("PLH_WINE_FLAVOR", "plh"))
        self.combo_wine_flavor.setCurrentIndex(idx_wf if idx_wf >= 0 else 0)

        self.combo_winedebug.setCurrentText(cfg.get("WINEDEBUG", "-all"))
        idx_dxvk = self.combo_dxvk_log.findData(cfg.get("DXVK_LOG_LEVEL", "info"))
        self.combo_dxvk_log.setCurrentIndex(idx_dxvk if idx_dxvk >= 0 else 3)

        self.chk_bridge_verbose.setChecked(cfg.get("PLH_BRIDGE_VERBOSE", "0") == "1")
        try:
            self.spin_bridge_port.setValue(int(cfg.get("PLH_BRIDGE_PORT", "0")))
        except ValueError:
            self.spin_bridge_port.setValue(0)

    def save_bridge_tab(self, restart: bool = False):
        cfg = {
            "PLH_CAPTURE_BACKEND": self.combo_cap_backend.currentData(),
            "PLH_D3D_TRACE": "1" if self.chk_d3d_trace.isChecked() else "0",
            "PLH_ENABLE_AMF": "1" if self.chk_enable_amf.isChecked() else "0",
            "PLH_ENC_DEVICE": self.combo_dri_dev.currentText().strip() or "/dev/dri/renderD128",
            "PLH_AMF_LOG": self.edit_amf_log.text().strip(),
            "PLH_ENABLE_INPUT": "1" if self.chk_enable_input.isChecked() else "0",
            "PLH_ENABLE_GAMEPAD": "1" if self.chk_enable_gamepad.isChecked() else "0",
            "PLH_INPUT_BACKEND": "uinput" if self.chk_enable_input.isChecked() else "off",
            "PLH_INPUT_MOUSE_MODE": self.combo_mouse_mode.currentData(),
            "PLH_ENABLE_CLIPBOARD": "1" if self.chk_enable_clipboard.isChecked() else "0",
            "PLH_WINE_FLAVOR": self.combo_wine_flavor.currentData(),
            "WINEDEBUG": self.combo_winedebug.currentText().strip() or "-all",
            "DXVK_LOG_LEVEL": self.combo_dxvk_log.currentData(),
            "PLH_BRIDGE_VERBOSE": "1" if self.chk_bridge_verbose.isChecked() else "0",
            "PLH_BRIDGE_PORT": str(self.spin_bridge_port.value()),
        }
        write_config_env(cfg)
        self.status_bar.showMessage(f"Bridge configuration saved to {CONFIG_ENV}", 5000)
        if restart:
            self.run_host_action("restart")

    def reset_bridge_defaults(self):
        write_config_env(dict(DEFAULT_ENV))
        self.load_bridge_tab()
        self.status_bar.showMessage("Recommended values restored.", 4000)

    def load_hotkeys_tab(self):
        self.tbl_hotkeys.setRowCount(0)
        if not PARSEC_HOTKEY_JSON.exists():
            return
        try:
            data = json.loads(PARSEC_HOTKEY_JSON.read_text(encoding="utf-8", errors="replace"))
            if not isinstance(data, dict):
                return
            for row, (action, spec) in enumerate(data.items()):
                if not isinstance(spec, dict):
                    continue
                self.tbl_hotkeys.insertRow(row)
                it_act = QTableWidgetItem(str(action))
                it_act.setFlags(it_act.flags() & ~Qt.ItemIsEditable)
                self.tbl_hotkeys.setItem(row, 0, it_act)
                self.tbl_hotkeys.setItem(row, 1, QTableWidgetItem(str(spec.get("mod", 0))))
                self.tbl_hotkeys.setItem(row, 2, QTableWidgetItem(str(spec.get("key", 0))))
                self.tbl_hotkeys.setItem(
                    row, 3, QTableWidgetItem("true" if spec.get("global", False) else "false")
                )
        except Exception:
            pass

    def save_hotkeys_tab(self):
        out = {}
        for r in range(self.tbl_hotkeys.rowCount()):
            act = self.tbl_hotkeys.item(r, 0).text()
            try:
                mod = int(self.tbl_hotkeys.item(r, 1).text())
            except ValueError:
                mod = 0
            try:
                key = int(self.tbl_hotkeys.item(r, 2).text())
            except ValueError:
                key = 0
            glob = self.tbl_hotkeys.item(r, 3).text().strip().lower() in ("true", "1", "yes", "oui")
            out[act] = {"mod": mod, "key": key, "global": glob}
        PARSEC_APPDATA.mkdir(parents=True, exist_ok=True)
        PARSEC_HOTKEY_JSON.write_text(json.dumps(out, indent="\t") + "\n", encoding="utf-8")
        self.status_bar.showMessage(f"Shortcuts saved to {PARSEC_HOTKEY_JSON}", 5000)

    # =========================================================================
    # PIPEWIRE AUDIO & KWIN SCREENS
    # =========================================================================
    def refresh_audio_sinks(self):
        self.combo_audio_sink.clear()
        sinks = detect_pipewire_sinks()
        def_idx = 0
        for i, (sid, name, is_def) in enumerate(sinks):
            prefix = "★ [Default] " if is_def else ""
            self.combo_audio_sink.addItem(f"{prefix}{name} (ID {sid})", sid)
            if is_def:
                def_idx = i
        if sinks:
            self.combo_audio_sink.setCurrentIndex(def_idx)
        else:
            self.combo_audio_sink.addItem("Session default PipeWire output", "")

    def apply_audio_sink(self):
        sid = self.combo_audio_sink.currentData()
        if not sid:
            return
        subprocess.run(["wpctl", "set-default", str(sid)], check=False)
        self.refresh_audio_sinks()
        self.status_bar.showMessage(f"Default PipeWire output changed to ID {sid}.", 4000)

    def refresh_displays_table(self):
        outs = [o for o in detect_kwin_outputs() if o.get("enabled")]
        self.tbl_displays.setRowCount(0)
        prim_x, prim_y = 0, 0
        for o in outs:
            if o.get("priority") == 1:
                m = re.match(r"(-?\d+),(-?\d+)", o.get("geometry", ""))
                if m:
                    prim_x, prim_y = int(m.group(1)), int(m.group(2))
                break

        self.lbl_displays_summary.setText(
            f"{len(outs)} active screen(s) detected. "
            f"Automatic Windows → KWin translation: ({prim_x:+d}, {prim_y:+d}) px."
        )
        for row, o in enumerate(outs):
            self.tbl_displays.insertRow(row)
            geom = o.get("geometry", "")
            win_coords = "—"
            m = re.match(r"(-?\d+),(-?\d+)\s+(\d+x\d+)", geom)
            if m:
                wx = int(m.group(1)) - prim_x
                wy = int(m.group(2)) - prim_y
                win_coords = f"{wx},{wy} ({m.group(3)})"
            prio = "1 (Primary)" if o.get("priority") == 1 else str(o.get("priority"))
            for col, val in enumerate([o["name"], prio, geom, win_coords, o.get("mode", "")]):
                self.tbl_displays.setItem(row, col, QTableWidgetItem(val))

    # =========================================================================
    # REAL-TIME STATUS, TELEMETRY & PROCESS CONTROL
    # =========================================================================
    def _find_pid(self, pattern: str) -> str:
        try:
            res = subprocess.run(
                ["pgrep", "-f", pattern],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            )
            pids = [p.strip() for p in res.stdout.splitlines() if p.strip()]
            return ", ".join(pids)
        except Exception:
            return ""

    def refresh_status(self):
        patterns = {
            "parsecd": r"parsecd\.exe",
            "plh-bridge": r"build/bridge/plh-bridge",
            "plh-input-hook": r"plh-input-hook\.exe",
            "plh-clipd": r"plh-clipd\.sh",
            "plh-clipsync": r"plh-clipsync\.exe",
        }
        for key, pat in patterns.items():
            pids = self._find_pid(pat)
            ok = bool(pids)
            self.badges[key].set_state(ok, "Running" if ok else "Stopped")
            self.pid_labels[key].setText(f"PID {pids}" if ok else "")

        # /dev/uinput permissions
        uinput_ok = os.access("/dev/uinput", os.W_OK)
        self.badges["uinput"].set_state(
            uinput_ok, "Accessible (OK)" if uinput_ok else "Access denied", warn=not uinput_ok
        )

        # Service systemd
        unit_dst = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / (
            "systemd/user/parsec-linux-host.service"
        )
        sysd_ok = unit_dst.exists()
        self.badges["systemd"].set_state(
            sysd_ok, "Enabled" if sysd_ok else "Disabled", warn=not sysd_ok
        )
        self.btn_systemd.setText(
            "Disable at login" if sysd_ok else "Enable at login"
        )

        # Read telemetry & client connection from log.txt
        self._update_telemetry_from_log()

        if self.tabs.currentIndex() == 4 and self.chk_log_autoscroll.isChecked():
            self.refresh_log_view()

    def _update_telemetry_from_log(self):
        if not PARSEC_LOG.exists():
            self.badges["client"].set_state(False, "No client", warn=True)
            return
        try:
            with PARSEC_LOG.open("rb") as f:
                f.seek(0, os.SEEK_END)
                size = f.tell()
                f.seek(max(0, size - 32768), os.SEEK_SET)
                tail = f.read().decode("utf-8", errors="replace").replace("\r", "")
        except Exception:
            return

        connected = False
        last_peer = "—"
        encoder = "—"
        codec = "—"
        enc_x, enc_y = "—", "—"
        last_fps, last_lat, last_bit, last_net = "—", "—", "—", "—"

        for line in tail.splitlines():
            m_conn = re.search(r"\]\s+(\S+#\d+)\s+(connected|disconnected)\.$", line)
            if m_conn:
                last_peer = m_conn.group(1)
                connected = m_conn.group(2) == "connected"
            elif "encoder       =" in line:
                encoder = line.split("=", 1)[1].strip()
            elif "codec         =" in line:
                codec = line.split("=", 1)[1].strip()
            elif "encode_x      =" in line:
                enc_x = line.split("=", 1)[1].strip()
            elif "encode_y      =" in line:
                enc_y = line.split("=", 1)[1].strip()
            elif "FPS:" in line and "L:" in line:
                m_m = re.search(
                    r"FPS:([\d.]+/\d+),\s*L:([\d.]+/[\d.]+),\s*B:([\d.]+/[\d.]+),\s*N:(\S+)",
                    line,
                )
                if m_m:
                    last_fps = m_m.group(1)
                    last_lat = f"{m_m.group(2)} ms"
                    last_bit = f"{m_m.group(3)} Mbit/s"
                    last_net = m_m.group(4)

        self.badges["client"].set_state(
            connected, "Connected" if connected else "No client", warn=not connected
        )
        self.pid_labels["client"].setText(last_peer if connected else "")
        self.lbl_metric_client.setText(f"{last_peer} ({'online' if connected else 'disconnected'})")
        self.lbl_metric_encoder.setText(f"{encoder.upper()} ({codec.upper()})" if encoder != "—" else "—")
        self.lbl_metric_res.setText(f"{enc_x} × {enc_y}" if enc_x != "—" else "—")
        self.lbl_metric_fps.setText(last_fps)
        self.lbl_metric_lat.setText(last_lat)
        self.lbl_metric_bitrate.setText(last_bit)
        self.lbl_metric_net.setText(last_net)

    def confirm_and_stop(self):
        if self.badges["client"].text() == "Connected":
            ans = QMessageBox.question(
                self,
                "Client currently connected",
                "A client is connected to Parsec. Stopping the host will cut its session.\nContinue?",
                QMessageBox.Yes | QMessageBox.No,
            )
            if ans != QMessageBox.Yes:
                return
        self.run_host_action("stop")

    def save_and_restart(self):
        self.save_parsec_tab(restart=False)
        self.save_bridge_tab(restart=False)
        self.run_host_action("restart")

    def toggle_systemd(self):
        is_enabled = self.badges["systemd"].text() == "Enabled"
        self.run_host_action("disable" if is_enabled else "enable")

    def emergency_release_inputs(self):
        subprocess.run(["pkill", "-f", r"plh-input-hook\.exe"], check=False)
        self.status_bar.showMessage("Keys/buttons released (plh-input-hook stopped).", 4000)
        self.refresh_status()

    def create_desktop_entry(self):
        apps_dir = Path.home() / ".local" / "share" / "applications"
        apps_dir.mkdir(parents=True, exist_ok=True)
        desktop_file = apps_dir / "parsec-linux-host.desktop"
        content = (
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=Parsec Linux Host Config\n"
            "Comment=Configure and control the Parsec host on Linux\n"
            f"Exec={ROOT / 'bin' / 'parsec-config-ui'}\n"
            "Icon=preferences-desktop-remote-desktop\n"
            "Terminal=false\n"
            "Categories=Network;RemoteAccess;Settings;\n"
        )
        desktop_file.write_text(content, encoding="utf-8")
        self.status_bar.showMessage(f"Shortcut created: {desktop_file}", 5000)

    def run_host_action(self, action: str):
        if self.runner and self.runner.isRunning():
            return
        self.status_bar.showMessage(f"Running: parsec-linux-host {action} ...")
        self.btn_start.setEnabled(False)
        self.btn_stop.setEnabled(False)
        self.btn_restart.setEnabled(False)

        self.runner = CommandRunner([str(HOST_CTL), action], self)
        self.runner.finished_cmd.connect(self._on_action_done)
        self.runner.start()

    def _on_action_done(self, rc: int, output: str):
        self.btn_start.setEnabled(True)
        self.btn_stop.setEnabled(True)
        self.btn_restart.setEnabled(True)
        msg = output.splitlines()[-1] if output else f"Return code {rc}"
        self.status_bar.showMessage(f"Done: {msg}", 5000)
        self.refresh_status()

    def refresh_log_view(self):
        path_str = self.combo_logfile.currentData()
        if not path_str:
            return
        p = Path(path_str)
        if not p.exists():
            self.txt_logs.setPlainText(f"[File not found: {p}]")
            return
        try:
            with p.open("rb") as f:
                f.seek(0, os.SEEK_END)
                sz = f.tell()
                f.seek(max(0, sz - 65536), os.SEEK_SET)
                text = f.read().decode("utf-8", errors="replace").replace("\r", "")
            flt = self.edit_log_filter.text().strip().lower()
            if flt:
                lines = [ln for ln in text.splitlines() if flt in ln.lower()]
                text = "\n".join(lines[-400:])
            else:
                text = "\n".join(text.splitlines()[-400:])
            if self.txt_logs.toPlainText() != text:
                self.txt_logs.setPlainText(text)
                if self.chk_log_autoscroll.isChecked():
                    sb = self.txt_logs.verticalScrollBar()
                    sb.setValue(sb.maximum())
        except Exception as exc:
            self.txt_logs.setPlainText(f"Read error: {exc}")


def apply_dark_theme(app: QApplication):
    app.setStyle("Fusion")
    pal = QPalette()
    pal.setColor(QPalette.Window, QColor(28, 30, 36))
    pal.setColor(QPalette.WindowText, QColor(230, 233, 240))
    pal.setColor(QPalette.Base, QColor(20, 22, 27))
    pal.setColor(QPalette.AlternateBase, QColor(34, 37, 44))
    pal.setColor(QPalette.ToolTipBase, QColor(40, 44, 52))
    pal.setColor(QPalette.ToolTipText, QColor(230, 233, 240))
    pal.setColor(QPalette.Text, QColor(230, 233, 240))
    pal.setColor(QPalette.Button, QColor(40, 44, 54))
    pal.setColor(QPalette.ButtonText, QColor(230, 233, 240))
    pal.setColor(QPalette.BrightText, Qt.red)
    pal.setColor(QPalette.Highlight, QColor(45, 115, 210))
    pal.setColor(QPalette.HighlightedText, Qt.white)
    app.setPalette(pal)
    app.setStyleSheet(
        "QGroupBox { font-weight: bold; border: 1px solid #3a3f4b; border-radius: 6px; "
        "margin-top: 8px; padding-top: 10px; } "
        "QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #7cb7ff; } "
        "QTabWidget::pane { border: 1px solid #3a3f4b; border-radius: 4px; } "
        "QTabBar::tab { padding: 8px 16px; font-weight: bold; } "
        "QTabBar::tab:selected { background-color: #2d73d2; color: white; border-radius: 4px; } "
        "QPushButton { border-radius: 5px; padding: 6px 12px; border: 1px solid #4a5060; } "
        "QPushButton:hover { border-color: #7cb7ff; } "
        "QLineEdit, QComboBox, QSpinBox, QPlainTextEdit { "
        "border: 1px solid #3e4452; border-radius: 4px; padding: 4px; }"
    )


def main():
    app = QApplication(sys.argv)
    apply_dark_theme(app)
    win = ParsecConfigWindow()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
