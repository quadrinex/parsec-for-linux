#!/usr/bin/env bash
# Starts, stops and describes the Parsec host under Wine.
# Usage : parsec-linux-host start|stop|restart|status|open|config|tray|enable|disable|launcher add|remove
set -u
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
UNIT=parsec-linux-host.service
TRAY_UNIT=parsec-tray.service
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_DST="$UNIT_DIR/$UNIT"
TRAY_UNIT_DST="$UNIT_DIR/$TRAY_UNIT"
APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
DESKTOP_DST="$APPS_DIR/parsec-for-linux.desktop"
. "$ROOT/runtime/env.sh"
LOG="$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/Parsec/log.txt"

running() { pgrep -f 'parsecd\.exe' >/dev/null; }

client_connected() {
    # A crash leaves "connected." as the last line of the log.
    running && [ -f "$LOG" ] || return 1
    # The Parsec log uses CRLF line endings.
    tr -d '\r' <"$LOG" | grep -aE ' (dis)?connected\.$' | tail -1 | grep -q ' connected\.$'
}

# At session start the screens appear one at a time, and Wine keeps the layout it saw first.
screen_layout() {
    xrandr --listmonitors 2>/dev/null || kscreen-doctor -o 2>/dev/null
}

wait_for_screens() {
    local prev="" cur stable=0 tries=0
    while [ "$stable" -lt 5 ] && [ "$tries" -lt 60 ]; do
        cur="$(screen_layout)"
        if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then stable=$((stable + 1)); else stable=0; fi
        prev="$cur"; tries=$((tries + 1))
        sleep 1
    done
}

have_tray() { python3 -c 'import PySide6.QtWidgets' 2>/dev/null; }

tray_running() { pgrep -f 'bin/parsec-tra[y]' >/dev/null; }

# The tray is optional: without PySide6 the host runs as before. One tray only, and it survives
# host restarts (stop never touches it).
ensure_tray() {
    have_tray || return 0
    tray_running && return 0
    if [ -e "$TRAY_UNIT_DST" ]; then
        systemctl --user start "$TRAY_UNIT" 2>/dev/null && return 0
    fi
    setsid nohup "$ROOT/bin/parsec-tray" >"$PLH_TRACES/parsec-tray.log" 2>&1 </dev/null &
}

start() {
    ensure_tray
    if running; then echo "already running"; return 0; fi
    wait_for_screens
    local layout
    layout="$(screen_layout)"
    [ -z "$layout" ] || printf '%s\n' "$layout" >"$PLH_TRACES/screen-layout"
    pgrep -f 'parsec-linux-host[ ]watch' >/dev/null || nohup "$0" watch >/dev/null 2>&1 </dev/null &
    "$ROOT/runtime/run-parsec.sh" --full
}

# Wine and the uinput absolute device only know the layout seen at start: a screen change needs
# a restart. It cuts a session, so it waits until no client is connected.
screens_changed() {
    local cur
    cur="$(screen_layout)"
    # Empty: the session is ending, not a layout change.
    [ -n "$cur" ] && [ "$cur" != "$(cat "$PLH_TRACES/screen-layout" 2>/dev/null)" ]
}

watch_screens() {
    while sleep 3; do
        screens_changed || continue
        wait_for_screens
        while client_connected; do sleep 3; done
        screens_changed || continue
        # A flapping layout must not restart in a loop.
        [ $(($(date +%s) - $(stat -c %Y "$PLH_TRACES/screen-layout"))) -ge 60 ] || continue
        exec "$0" restart
    done
}

stop() {
    # Order: the relay first (it releases keys and buttons on exit), then the daemon.
    pkill -f 'parsec-linux-host[ ]watch' 2>/dev/null
    pkill -f 'plh-pad-relay\.exe' 2>/dev/null
    pkill -f 'plh-input-hook\.exe' 2>/dev/null
    pkill -f 'plh-clipsync\.exe' 2>/dev/null
    pkill -f 'plh-clipd\.sh' 2>/dev/null
    if [ -d "$WINEPREFIX" ]; then
        "$WINESERVER" -k 2>/dev/null
    fi
    pkill -x plh-bridge 2>/dev/null
    return 0
}

status() {
    local rc=0 name pat
    for name in parsecd plh-bridge plh-input-hook plh-pad-relay plh-clipd plh-clipsync layout-watch; do
        case $name in
            parsecd) pat='parsecd\.exe' ;;
            plh-bridge) pat='build/bridge/plh-bridge' ;;
            plh-input-hook) pat='plh-input-hook\.exe' ;;
            plh-pad-relay) pat='plh-pad-relay\.exe' ;;
            plh-clipd) pat='plh-clipd\.sh' ;;
            plh-clipsync) pat='plh-clipsync\.exe' ;;
            layout-watch) pat='parsec-linux-host[ ]watch' ;;
        esac
        if pgrep -f "$pat" >/dev/null; then printf '%-16s running\n' "$name"
        else printf '%-16s stopped\n' "$name"; [ "$name" = layout-watch ] || rc=3; fi
    done
    if client_connected; then echo "client           connected"; else echo "client           none"; fi
    return $rc
}

# Shows the Parsec window, which Parsec hides when it starts. Starts the host first if needed.
open_parsec() {
    local winctl="$ROOT/build/runtime/winctl.exe" src="$ROOT/runtime/tools/winctl.c" i
    if [ ! -f "$winctl" ] || [ "$src" -nt "$winctl" ]; then
        mkdir -p "$ROOT/build/runtime"
        x86_64-w64-mingw32-gcc -O2 -Wall -Wextra -municode -o "$winctl" "$src" 2>/dev/null || true
    fi
    running || start >/dev/null
    for i in $(seq 60); do
        if WINEDEBUG=-all "$WINE" "$winctl" show Parsec >/dev/null 2>&1; then return 0; fi
        sleep 1
    done
    echo "the Parsec window did not appear" >&2
    command -v notify-send >/dev/null && notify-send -a Parsec "Parsec" "The Parsec window did not appear. See $PLH_TRACES." || true
    return 1
}

# parsec-tray is a single instance: if a tray is running it only opens the window there.
open_config() {
    if ! have_tray; then
        echo "the settings window needs PySide6 (pacman -S pyside6)." >&2
        echo "settings file: $(python3 -c "import sys; sys.path.insert(0, '$ROOT/runtime'); import plhconfig; print(plhconfig.config_path())")" >&2
        return 1
    fi
    exec "$ROOT/bin/parsec-tray" --settings
}

# Application menu entry and its icon. The icon is made here from what is on this machine.
launcher() {
    case "${1:-}" in
        add)
            mkdir -p "$APPS_DIR"
            sed "s|@BIN@|$ROOT/bin/parsec-linux-host|g" "$ROOT/packaging/desktop/parsec-for-linux.desktop" >"$DESKTOP_DST"
            python3 -I "$ROOT/runtime/make-icon.py" install || true
            command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 >/dev/null 2>&1 || true
            # A Parsec entry generated by Wine would appear twice in the menu.
            grep -lsE '^Exec=.*parsecd' "$APPS_DIR"/*.desktop "$APPS_DIR"/wine/Programs/*/*.desktop "$APPS_DIR"/wine/Programs/*.desktop 2>/dev/null |
                grep -v "$DESKTOP_DST" | sed 's/^/warning: duplicate menu entry: /' >&2
            ;;
        remove)
            rm -f "$DESKTOP_DST"
            python3 -I "$ROOT/runtime/make-icon.py" remove || true
            command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 >/dev/null 2>&1 || true
            ;;
        *) echo "usage : $0 launcher add|remove" >&2; return 2 ;;
    esac
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 2; start ;;
    status) status ;;
    watch) watch_screens ;;
    open) open_parsec ;;
    tray) ensure_tray ;;
    launcher) launcher "${2:-}" ;;
    enable)
        mkdir -p "$UNIT_DIR"
        sed "s|@ROOT@|$ROOT|g" "$ROOT/packaging/systemd/$UNIT" >"$UNIT_DST"
        sed "s|@ROOT@|$ROOT|g" "$ROOT/packaging/systemd/$TRAY_UNIT" >"$TRAY_UNIT_DST"
        systemctl --user daemon-reload
        systemctl --user enable "$UNIT"
        have_tray && systemctl --user enable "$TRAY_UNIT"
        launcher add
        ;;
    disable)
        systemctl --user disable "$UNIT" "$TRAY_UNIT" 2>/dev/null
        rm -f "$UNIT_DST" "$TRAY_UNIT_DST"
        systemctl --user daemon-reload
        ;;
    config|ui|gui) open_config ;;
    *) echo "usage : $0 start|stop|restart|status|open|config|tray|enable|disable|launcher add|remove" >&2; exit 2 ;;
esac
